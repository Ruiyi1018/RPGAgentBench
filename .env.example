# Venus is the default backend for benchmark and data-generation calls.
LLM_PROVIDER=venus

# Preferred: complete application-group proxy token.
VENUS_API_KEY=

# Optional personal-debug fallback. Keep blank in committed files.
ENV_VENUS_OPENAPI_SECRET_ID=
VENUS_TOKEN_SUFFIX=

VENUS_BASE_URL=https://v2.open.venus.woa.com/llmproxy
VENUS_MODEL=deepseek-v4-pro
VENUS_TIMEOUT=300
VENUS_MAX_ATTEMPTS=3
